# ── תצורת שרת ──────────────────────────────────────────────────
# כל הערכים אופציונליים; ברירות המחדל מתאימות להרצה מקומית.

# פורט וכתובת האזנה
PORT=3000
HOST=0.0.0.0

# סביבת ההרצה: development | production
NODE_ENV=production

# כתובת ציבורית לבניית קישור ההצטרפות וה-QR.
# חובה כשהשרת רץ מאחורי פרוקסי שמשנה את כותרת המארח.
# ב-Render וב-Railway אין צורך להגדיר — הכתובת נבנית אוטומטית
# מ-RENDER_EXTERNAL_URL או מ-RAILWAY_PUBLIC_DOMAIN, בהתאמה.
# כשכולם חסרים, הכתובת נגזרת אוטומטית מכותרות הבקשה.
# PUBLIC_BASE_URL=https://mihazamar.example.com

# מקורות מותרים ל-CORS, מופרדים בפסיק. * מתיר הכול.
CORS_ORIGINS=*

# משך חוסר פעילות (בדקות) שאחריו חדר נטוש נסגר
ROOM_TTL_MINUTES=240

# תקרת חדרים פעילים בתהליך
MAX_ROOMS=500

# הגשת קבצי הלקוח הבנויים מתוך אותו שרת
SERVE_CLIENT=true
CLIENT_DIR=client/dist

# כיבוד כותרות X-Forwarded-* (נדרש מאחורי פרוקסי)
TRUST_PROXY=true

# רמת לוג: debug | info | warn | error
LOG_LEVEL=info
