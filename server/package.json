{
  "name": "@mihazamar/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "שרת המשחק — ניהול חדרים, מכונת מצבים וסנכרון בזמן אמת",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mihazamar/shared": "*",
    "compression": "^1.7.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
